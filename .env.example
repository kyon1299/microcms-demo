# microCMS のサービスドメイン（https://xxxx.microcms.io の xxxx 部分）
MICROCMS_SERVICE_DOMAIN=
# 読み取り用 API キー（GET 権限のみ）
MICROCMS_API_KEY=
# Webhook の署名検証用シークレット（microCMS の Webhook 設定と同じ値）
MICROCMS_WEBHOOK_SECRET=

# 移行スクリプト用 API キー（blogs / categories の GET・POST・PUT・PATCH 権限）
# サイトの本番環境には設定しないこと
MICROCMS_WRITE_API_KEY=
